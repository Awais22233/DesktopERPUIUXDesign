{
  "name": "wholesale-erp",
  "productName": "Wholesale ERP",
  "version": "0.1.0",
  "description": "Configurable offline wholesale and retail ERP / POS",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test.mjs",
    "pack:win": "node scripts/prep-icon.mjs && electron-vite build && electron-builder --win --x64 --publish never",
    "pack:dir": "node scripts/prep-icon.mjs && electron-vite build && electron-builder --dir --publish never",
    "postinstall": "electron-builder install-app-deps",
    "license": "node tools/license.mjs",
    "e2e": "node e2e/run.mjs",
    "pack:linux": "node scripts/prep-icon.mjs && electron-vite build && electron-builder --linux --x64 --publish never",
    "license:page": "node tools/build-generator.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.0",
    "better-sqlite3": "^12.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "playwright-core": "^1.50.0",
    "tailwindcss": "^4.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@12.8.1",
  "author": "Awais"
}
